// MC shadow depth material. Mirrors the CSM addon's shadowmap_world recipe
// (screenspace_general depth writer for IMesh world geometry): no $model,
// $flags2 forced to 0 through the Equals proxy. The Lua shadow pass sets
// $c0_* / $c1_* every update (light forward + 1/zfar, light origin) and binds
// the block atlas to $basetexture so the pixel shader can alpha-test casters.
screenspace_general
{
	$pixshader 		"mc_gpu_shadow_depth4_ps30"
	$vertexshader 	"mc_gpu_shadow_depth3_vs30"

	$nodecal        1
	$nofog          1
	$linearwrite    1
	$ALPHATESTED    0

	"<dx90"
	{
		$no_draw 1
	}

	$c0_x 0
	$c0_y 0
	$c0_z -1
	$c0_w 0.0001
	$c1_x 0
	$c1_y 0
	$c1_z 0
	$c1_w 0

	$mc_flags2 0

	Proxies
	{
		Equals
		{
			srcVar1		$mc_flags2
			resultVar	$flags2
		}
	}
}
