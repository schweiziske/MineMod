"UnlitGeneric"
{
    "$basetexture" "mcitem/enchantments/fire_1"
    "$alphatest" "1"
    "$alphatestreference" "0.1"
    "$vertexcolor" "1"
    "$nocull" "1"
    "$pointsample" "1"
    "Proxies"
    {
        "AnimatedTexture"
        {
            "animatedTextureVar" "$basetexture"
            "animatedTextureFrameNumVar" "$frame"
            "animatedTextureFrameRate" "20"
        }
    }
}
