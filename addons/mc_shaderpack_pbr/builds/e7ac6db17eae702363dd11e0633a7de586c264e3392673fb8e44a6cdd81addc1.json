      ],
      "normal": "s3=256x256 repeating XYZ normal, A=foam noise, smooth mipmapped linear data; PNG import requires noclamp",
      "transform": "invviewprojmat transports wrapped chunk phase/inverse block size, motion, scattering/foam, absorption/reflection",
      "passes": "current-view scene copy followed by one translucent colour draw per fluid batch; depth test without depth write"
    },
