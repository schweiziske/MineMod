// MC shadow depth material, Photon-style distorted variant. Same recipe as
// pp/mc_shadow_depth3 (screenspace_general depth writer, MRT COLOR1 linear
// depth, atlas alpha-test) but the vertex shader radially warps the ortho
// clip position so the single shadow map concentrates its texels near the
// camera. Used by mc_shadow_mode "map"; the cascade atlas ("csm") keeps
// pp/mc_shadow_depth3.
screenspace_general
{
	$pixshader 		"mc_gpu_shadow_depth3_ps30"
	$vertexshader 	"mc_gpu_shadow_depth_distort1_vs30"

	$nodecal        1
	$nofog          1
	$linearwrite    1
	$ALPHATESTED    0

	"<dx90"
	{
		$no_draw 1
	}

	$c0_x 0
	$c0_y 0
	$c0_z -1
	$c0_w 0.0001
	$c1_x 0
	$c1_y 0
	$c1_z 0
	$c1_w 0

	$mc_flags2 0

	Proxies
	{
		Equals
		{
			srcVar1		$mc_flags2
			resultVar	$flags2
		}
	}
}
