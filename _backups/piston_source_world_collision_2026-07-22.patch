diff --git a/_tools/test_piston_runtime.lua b/_tools/test_piston_runtime.lua
index cb082566..cccb8a15 100644
--- a/_tools/test_piston_runtime.lua
+++ b/_tools/test_piston_runtime.lua
@@ -1,5 +1,8 @@
-MC = { BlockByName = {}, Visuals = {}, UpdateHandlers = {}, ModelTransforms = {} }
+SERVER = true
+MC = { SV = {}, BlockByName = {}, Visuals = {}, UpdateHandlers = {}, ModelTransforms = {} }
 local Powered = false
+local SourceWorldBlocked = false
+local SourceWorldBlockedFromY
 
 local World = {}
 local function key( x, y, z ) return x .. ":" .. y .. ":" .. z end
@@ -34,6 +37,10 @@ function MC.StateVisualPlanModelAtFast( stateId ) return stateId end
 function MC.RegisterStateVisualModelTransform( modelId, transform ) MC.ModelTransforms[modelId] = transform end
 function MC.RedstoneBestNeighborSignal() return Powered and 15 or 0 end
 function MC.GetBlockEntity() return nil end
+function MC.SV.SourceWorldCanTraverse( _, sy )
+	return not SourceWorldBlocked and sy ~= SourceWorldBlockedFromY
+end
+function MC.SV.SourceWorldCellBlocked() return SourceWorldBlocked end
 
 dofile( "lua/mc/redstone/sh_piston.lua" )
 
@@ -127,4 +134,36 @@ assert( movedObserver and movedObserver.stateId == 610, "observer did not move t
 assert( movedObserver.movedFromX == 0 and movedObserver.movedFromY == -1 and movedObserver.movedFromZ == 0,
 	"moved observer lost its original position metadata" )
 
+World = {}
+set( 0, 0, 0, 501 )
+set( 0, -1, 0, 600 )
+set( 0, -2, 0, 603 )
+Powered = true
+movement = MC.UpdateHandlers["minecraft:piston"].OnScheduledTick( {
+	bx = 0, by = 0, bz = 0, stateId = 501,
+} )
+assert( movement == nil, "immovable front stopper did not cancel the complete piston movement" )
+assert( get( 0, -1, 0 ) == 600 and get( 0, -2, 0 ) == 603,
+	"failed piston planning changed the machine or its stopper" )
+
+World = {}
+set( 0, 0, 0, 501 )
+set( 0, -1, 0, 602 )
+Powered = true
+SourceWorldBlockedFromY = -1
+movement = MC.UpdateHandlers["minecraft:piston"].OnScheduledTick( {
+	bx = 0, by = 0, bz = 0, stateId = 501,
+} )
+assert( movement == nil, "piston moved a block through Source map geometry" )
+SourceWorldBlockedFromY = nil
+
+World = {}
+set( 0, 0, 0, 501 )
+SourceWorldBlocked = true
+movement = MC.UpdateHandlers["minecraft:piston"].OnScheduledTick( {
+	bx = 0, by = 0, bz = 0, stateId = 501,
+} )
+assert( movement == nil, "piston head extended into Source map geometry" )
+SourceWorldBlocked = false
+
 print( "piston connected-part runtime checks passed" )
