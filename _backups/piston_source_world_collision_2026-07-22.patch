+local function movementFace( move )
+	if move[3] > 0 then return 1 end
+	if move[3] < 0 then return 2 end
+	if move[1] > 0 then return 3 end
+	if move[1] < 0 then return 4 end
+	if move[2] > 0 then return 5 end
+	return 6
+end
+
+local function sourceWorldBlocksMove( bx, by, bz, move )
+	if not SERVER or not MC.SV then return false end
+	local tx, ty, tz = bx + move[1], by + move[2], bz + move[3]
+	local canTraverse = MC.SV.SourceWorldCanTraverse
+	if canTraverse and not canTraverse( bx, by, bz, tx, ty, tz, movementFace( move ) ) then return true end
+	local cellBlocked = MC.SV.SourceWorldCellBlocked
+	return cellBlocked and cellBlocked( tx, ty, tz ) == true or false
+end
