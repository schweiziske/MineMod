float4 MCDepthForward : register(c0);
float4 MCDepthOrigin : register(c1);
struct MCShadowFragment { centroid float2 uv : TEXCOORD0; float3 world : TEXCOORD1; };

float4 main(MCShadowFragment input) : COLOR0
{
    // Match the existing horizontal-interface filter; no pattern in geometry.
    float3 normal = cross(ddx(input.world), ddy(input.world));
    clip(abs(normal.z) - length(normal.xy));
    float depth = saturate(dot(input.world - MCDepthOrigin.xyz, MCDepthForward.xyz) * MCDepthForward.w);
    float value = floor(depth * 65535.0f + 0.5f);
    float high = floor(value / 256.0f);
    return float4((value - high * 256.0f) / 255.0f, high / 255.0f, 0.25f, 0.25f);
}
