#define MC_VERTEX_STAGE 1
#include "adapter/bindings.fxh"
#include "water/interface.fxh"

struct MCWaterVertex
{
    float4 position : POSITION0;
    float2 uv : TEXCOORD0;
    float4 color : COLOR0;
};

MCWaterFragment main(MCWaterVertex input)
{
    MCWaterFragment output;
    output.position = mul(input.position, MCModelViewProjection);
    output.worldPosition = mul(input.position, MCModel);
    output.derivativeWorldPosition = output.worldPosition;
    output.uv = input.uv;
    output.derivativeUV = input.uv;
    output.lightDepthShore = input.color;
    output.clipW = output.position.w;
    return output;
}
