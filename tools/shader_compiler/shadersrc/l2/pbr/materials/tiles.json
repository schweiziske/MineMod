{
  "schema": 3,
  "outputSize": [4096, 2048],
  "default": {"profile": "relief", "response": "", "roughness": 0.9, "metallic": 0, "subsurface": 0, "emission": 0, "bump": 0.2, "roughnessVariation": 0.03, "bevel": 0, "bevelWidth": 0.018, "specular": 0.7},
  "profiles": {
    "relief": {},
    "metal": {"response": "metal", "roughness": 0.3, "metallic": 1, "bump": 0.2, "roughnessVariation": 0.035, "specular": 1},
    "stone": {"response": "stone", "roughness": 0.9, "bump": 0.38, "roughnessVariation": 0.04, "specular": 0.55},
    "earth": {"response": "earth", "roughness": 0.96, "bump": 0.32, "roughnessVariation": 0.025, "specular": 0.4},
    "foliage": {"response": "foliage", "roughness": 0.985, "bump": 0.12, "roughnessVariation": 0.015, "specular": 0.3},
    "wood": {"response": "wood", "roughness": 0.97, "bump": 0.26, "roughnessVariation": 0.015, "specular": 0.08},
    "polished": {"response": "stone", "roughness": 0.45, "bump": 0.06, "roughnessVariation": 0.015, "specular": 1},
    "flat": {"response": "glass", "roughness": 0.09, "bump": 0, "roughnessVariation": 0, "specular": 1}
  },
  "rules": [
    {"match": "^(deepslate_)?(coal|iron|copper|gold|diamond|emerald|lapis|redstone)_ore$|^nether_(gold|quartz)_ore$", "profile": "stone", "response": "ore", "roughnessVariation": 0.015},
    {"match": "^(rail|powered_rail|detector_rail|activator_rail)(_|$)", "profile": "wood", "response": "rail", "bump": 0.12},
    {"match": "^(item_)?((exposed|weathered|oxidized)_)?copper_bulb(_|$)", "profile": "metal", "response": "copper_bulb", "bevel": 0},
    {"match": "^(item_)?((exposed|weathered|oxidized)_)?(copper_|soul_)?(torch|lantern)$", "profile": "wood", "response": "light", "bump": 0.08},
    {"match": "^(furnace|blast_furnace|smoker)_", "profile": "stone", "response": "furnace"},
    {"match": "^(soul_)?campfire_log_lit$", "profile": "wood", "response": "light"},
    {"match": "^(creaking_heart)(_|$)", "profile": "wood", "response": "creaking", "bump": 0.38},
    {"match": "^(trial_spawner|vault)(_|$)", "profile": "stone", "response": "trial"},
    {"match": "^calibrated_sculk_sensor_amethyst$", "profile": "polished"},
    {"match": "^(sculk|calibrated_sculk_sensor)(_|$)", "profile": "stone", "response": "sculk", "bump": 0.12},
    {"match": "^(item_)?((polished|chiseled|potent)_)?sulfur(_|$)", "profile": "stone", "response": "sulfur"},
    {"match": "^((polished|chiseled)_)?cinnabar(_|$)", "profile": "stone", "response": "cinnabar"},
    {"match": "^(resin|chiseled_resin)(_|$)", "profile": "polished", "response": "resin"},
    {"match": "(^|_)bed(_|$)", "profile": "earth", "response": "bed", "bump": 0.1, "specular": 0.15},
    {"match": "^(pale_)?moss_carpet(_|$)", "profile": "foliage"},
    {"match": "(wool|carpet|banner)", "profile": "earth", "response": "cloth", "bump": 0.08},
    {"match": "^(barrel|beehive|bee_nest|honeycomb_block)(_|$)", "profile": "wood", "response": "hive"},
    {"match": "^(water|glass|tinted_glass|.*_stained_glass)(_|$)", "profile": "flat"},
    {"match": "^(slime_block|honey_block)(_|$)", "profile": "flat", "response": "gel"},
    {"match": "^(ice|blue_ice|packed_ice|frosted_ice)(_|$)", "profile": "polished", "response": "glass", "roughness": 0.16},
    {"match": "^(diamond_block|emerald_block|amethyst_block|budding_amethyst|amethyst_cluster|(small|medium|large)_amethyst_bud)$", "profile": "polished", "roughness": 0.2},
    {"match": "^(oxidized|waxed_oxidized|weathered|waxed_weathered)_.*copper", "profile": "stone", "response": "metal", "roughness": 0.8, "metallic": 0.12},
    {"match": "^(exposed|waxed_exposed)_.*copper", "profile": "metal", "roughness": 0.52, "metallic": 0.62},
    {"match": "^gold_block$", "profile": "metal", "roughness": 0.2, "bevel": 0.15},
    {"match": "^iron_block$", "profile": "metal", "roughness": 0.31, "bevel": 0.12},
    {"match": "^netherite_block$", "profile": "metal", "roughness": 0.5, "bevel": 0.08},
    {"match": "^(waxed_)?(copper|cut_copper|chiseled_copper|copper_grate)(_|$)", "profile": "metal", "roughness": 0.29, "metallic": 0.95, "bevel": 0.12},
    {"match": "^(iron_door|iron_trapdoor|iron_bars|heavy_weighted_pressure_plate|light_weighted_pressure_plate)(_|$)", "profile": "metal", "roughness": 0.4, "metallic": 0.92},
    {"match": "^(raw_(copper|iron|gold)_block|anvil|chain|iron_chain)(_|$)", "profile": "metal"},
    {"match": "^(lava|fire|soul_fire|(soul_)?campfire_fire)(_|$)", "profile": "flat", "response": "fire", "roughness": 0.9},
    {"match": "^(glowstone|sea_lantern|shroomlight|redstone_lamp|jack_o_lantern|magma|end_rod|.*froglight)(_|$)", "response": "light", "roughness": 0.75, "bump": 0.1},
    {"match": "^(redstone_torch)(_|$)", "profile": "wood", "response": "redstone"},
    {"match": "^(obsidian|crying_obsidian)$", "profile": "polished", "response": "obsidian", "roughness": 0.35},
    {"match": "^grass_block_side$", "profile": "earth", "overlay": "grass_block_side_overlay", "overlayProfile": "foliage"},
    {"match": "^(podzol|mycelium|soul_soil)(_|$)", "profile": "earth"},
    {"match": "^flower_pot$", "profile": "stone", "specular": 0.35},
    {"match": "^(grass_block_snow|farmland|farmland_moist|sponge|wet_sponge)$", "profile": "earth"},
    {"match": "^(mossy_cobblestone|mossy_stone_bricks|sandstone|red_sandstone|smooth_sandstone|smooth_red_sandstone|chiseled_sandstone|chiseled_red_sandstone|cut_sandstone|cut_red_sandstone)$", "profile": "stone"},
    {"match": "(leaves|grass|fern|flower|vine|moss)", "profile": "foliage"},
    {"match": "(wool|carpet|sand|dirt|mud|snow|gravel)", "profile": "earth"},
    {"match": "^(oak|spruce|birch|jungle|acacia|dark_oak|mangrove|cherry|pale_oak)_log$|^(crimson|warped)_stem$", "profile": "wood", "roughness": 0.99, "roughnessVariation": 0.01, "specular": 0.05, "bump": 0.38},
    {"match": "(_log_top|(crimson|warped)_stem_top)$", "profile": "wood", "roughness": 0.985, "roughnessVariation": 0.015, "specular": 0.06},
    {"match": "(planks|log|wood|bamboo|bookshelf|crafting_table|barrel|ladder)|^(stripped_)?(crimson|warped)_(stem|hyphae)", "profile": "wood"},
    {"match": "^(item_)?(oak|spruce|birch|jungle|acacia|dark_oak|mangrove|cherry|pale_oak|crimson|warped)_(door|trapdoor|sign|hanging_sign|shelf)(_|$)", "profile": "wood"},
    {"match": "^(cartography_table|fletching_table|loom|lectern|jukebox|note_block|beehive|scaffolding)(_|$)", "profile": "wood"},
    {"match": "^(composter_(bottom|side|top)|smithing_table_(bottom|front|side)|daylight_detector_side|piston_top|lever)$", "profile": "wood"},
    {"match": "(polished|glazed|quartz|smooth_stone)", "profile": "polished", "roughness": 0.55},
    {"match": "(stone|brick|concrete|granite|andesite|diorite|deepslate|terracotta|tuff|calcite|prismarine|purpur|basalt|netherrack|bedrock)", "profile": "stone"}
  ]
}
