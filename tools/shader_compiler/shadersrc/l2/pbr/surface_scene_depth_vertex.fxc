float4x4 MCModelViewProjection : register(c4);
struct Fragment
{
    float4 position : POSITION0;
    float2 uv : TEXCOORD0;
    float viewDepth : TEXCOORD1;
};
Fragment main(float4 position : POSITION0, float2 uv : TEXCOORD0)
{
    Fragment output;
    output.position = mul(position, MCModelViewProjection);
    output.uv = uv;
    output.viewDepth = output.position.w;
    return output;
}
