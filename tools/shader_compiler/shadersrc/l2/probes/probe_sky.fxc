sampler SkySampler : register(s0);
struct PS_INPUT
{
    float2 uv : TEXCOORD0;
    float4 clipPosition : TEXCOORD1;
};

float4 main(PS_INPUT input) : COLOR
{
    float2 uv = input.clipPosition.xy / input.clipPosition.w;
    uv = uv * float2(0.5, -0.5) + 0.5;
    return float4(tex2D(SkySampler, uv).rgb, 1.0);
}
