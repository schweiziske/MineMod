// Source world-draw MVP. Avoid common_vs_fxc.h's external c0 literal pragmas.
float4x4 ProbeModelViewProjection : register(c4);

struct VS_INPUT
{
    float4 position : POSITION;
    float2 uv : TEXCOORD0;
};

struct VS_OUTPUT
{
    float4 position : POSITION;
    float2 uv : TEXCOORD0;
    float4 clipPosition : TEXCOORD1;
};

VS_OUTPUT main(VS_INPUT input)
{
    VS_OUTPUT output;
    output.position = mul(input.position, ProbeModelViewProjection);
    output.clipPosition = output.position;
    output.uv = input.uv;
    return output;
}
