#include "../pbr/materials/sampling.fxh"
sampler2D NormalMap : register(s3);
sampler2D SpecularMap : register(s4);
sampler2D ColorMap : register(s0);
float4 Probe : register(c0); // UV, calibrated LOD, normal/specular
float4 Mode : register(c1); // negative: previous sampler; nonnegative: PBR wrappers
float4 main() : COLOR0
{
    if (Mode.y>0) return mcPBRColor(ColorMap,Probe.xy,Probe.z,Mode.y==1);
    if (Mode.x>=0)
    {
        if (Probe.w>0) return mcPBRMaterial(NormalMap,Probe.xy,Probe.z,true);
        return mcPBRMaterial(SpecularMap,Probe.xy,Probe.z,false);
    }
    if (Probe.w>0)
        return mcResourceMaterial(NormalMap,Probe.xy,Probe.z,true);
    return mcResourceMaterial(SpecularMap,Probe.xy,Probe.z,false);
}
