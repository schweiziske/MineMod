#define HDRTYPE HDR_TYPE_NONE
#include "common_ps_fxc.h"
#include "mc_gpu_block_tint.fxh"

// FAST chunk lighting ("mc_light_style fast").
//
// Revival of the original low-sample GPU light shader: 4 light-texture taps
// (one bilinear face blend) + 1 atlas tap per pixel, analytic warm/cool
// tinting, per-face directional scale. No shadow sampling, no global
// lightmap lookups, no screen-space anything — the cheapest possible pixel
// while lighting still lives on the GPU.
//
// Differences from the historical mc_gpu_chunk_lighttex_ps30: the light
// texture's r channel no longer stores combined brightness (it is 0 in
// global-lightmap mode), so intensity is composed from the block (g) and
// sky-exposure (b) channels, with the day-cycle sky brightness, ambient
// floor and night tint arriving through ONE constant set once per frame.

sampler BaseTextureSampler : register(s0);
sampler ChunkLightSampler  : register(s1);
#include "mc_gpu_chunk_lighttex_packed.fxh"

// $c0_* -> c0 is the only external constant; the material must not define
// $c1..$c3 or $viewprojmat, leaving every other register free for
// compiler-placed literals.
float4 mcFastParams : register(c0); // x: day-cycle sky brightness, y: ambient floor, z: night blue weight, w: warm/cool tint strength

static const float3 MC_SKY_LIGHT_TINT = float3( 0.94f, 0.98f, 1.06f );
static const float3 MC_BLOCK_LIGHT_TINT = float3( 1.14f, 0.94f, 0.74f );
static const float MC_SKY_TINT_STRENGTH = 0.22f;
static const float MC_BLOCK_TINT_STRENGTH = 0.42f;
static const float3 MC_NIGHT_TINT = float3( 0.62f, 0.74f, 1.12f );

// _centroid: under MSAA, an edge pixel whose center lies outside the triangle
// otherwise EXTRAPOLATES every interpolant — UV lands past the atlas gutter
// (alpha-test holes) and local pos past the face (wrong light cell) — the
// block-edge seam artifact.
struct PS_INPUT
{
	float2 vTexCoord : TEXCOORD0_centroid;
	float3 vLocalPos : TEXCOORD1_centroid;
	float3 vWorldPos : TEXCOORD2_centroid;
	float4 vColor    : TEXCOORD3_centroid;
	float2 vLightTileOrigin : TEXCOORD5_centroid;
};

float3 faceScaleForIndex( float faceIndex )
{
	if ( faceIndex < 1.5f )
	{
		return float3( 1.06f, 1.03f, 0.94f );
	}
	else if ( faceIndex < 2.5f )
	{
		return ( 128.0f / 255.0f ) * float3( 0.76f, 0.82f, 0.98f );
	}
	else if ( faceIndex < 3.5f )
	{
		return ( 153.0f / 255.0f ) * float3( 0.96f, 0.99f, 1.04f );
	}
	else if ( faceIndex < 4.5f )
	{
		return ( 153.0f / 255.0f ) * float3( 0.86f, 0.90f, 1.02f );
	}
	else if ( faceIndex < 5.5f )
	{
		return ( 204.0f / 255.0f ) * float3( 1.02f, 1.00f, 0.94f );
	}
	return ( 204.0f / 255.0f ) * float3( 0.82f, 0.88f, 1.04f );
}

float3 composeFastLight( float3 lightChannels )
{
	float blockLight = saturate( lightChannels.g );
	float skyLight = saturate( lightChannels.b ) * saturate( mcFastParams.x );
	float intensity = max( max( blockLight, skyLight ), saturate( mcFastParams.y ) );

	float tintStrength = saturate( mcFastParams.w );
	float warm = saturate( blockLight * ( 1.0f - skyLight * 0.35f ) );
	float cool = saturate( skyLight * ( 1.0f - blockLight * 0.25f ) );
	float3 tint = 1.0f
		+ ( MC_BLOCK_LIGHT_TINT - 1.0f ) * warm * MC_BLOCK_TINT_STRENGTH * tintStrength
		+ ( MC_SKY_LIGHT_TINT - 1.0f ) * cool * MC_SKY_TINT_STRENGTH * tintStrength;

	// Night blue on sky-dominated surfaces; torch pools stay warm.
	float skyDominance = saturate( ( skyLight - blockLight ) * 2.0f );
	tint *= lerp( float3( 1.0f, 1.0f, 1.0f ), MC_NIGHT_TINT, saturate( mcFastParams.z ) * skyDominance );

	return saturate( intensity * tint );
}

HALF4 main( PS_INPUT i, float faceSign : VFACE ) : COLOR
{
	clip( faceSign );
	// tex2Dlod (explicit LOD 0): anisotropic minification must never widen the
	// atlas footprint past the 4px tile gutter into alpha=0 cells (seam holes).
	float4 albedo = tex2Dlod( BaseTextureSampler, float4( i.vTexCoord, 0.0f, 0.0f ) );
	clip( albedo.a - 0.5f );
	albedo.rgb *= mcBlockTint( i.vColor.b );

	float faceIndex = floor( i.vColor.g * 255.0f + 0.5f );
	float3 lightColor = composeFastLight( mcSampleSmoothFaceLight9( i.vLocalPos, faceIndex, i.vLightTileOrigin ) );
	float3 faceScale = faceScaleForIndex( faceIndex );

	return HALF4( saturate( albedo.rgb * lightColor * faceScale ), 1.0f );
}
