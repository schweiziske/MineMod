// STATIC: "X360APPCHOOSER" "0..1" [= 0]

#include "common_vs_fxc.h"

struct VS_INPUT
{
	float4 vPos      : POSITION;
	float2 vTexCoord : TEXCOORD0;
#if X360APPCHOOSER
	float4 vColor    : COLOR0;
#endif
};

struct VS_OUTPUT
{
	float4 vProjPos  : POSITION;
	float2 vTexCoord : TEXCOORD0;
	float3 vLocalPos : TEXCOORD1;
	float3 vWorldPos : TEXCOORD2;
#if X360APPCHOOSER
	float4 vColor    : TEXCOORD3;
#endif
	float4 vClipPos  : TEXCOORD4;
	float2 vLightTileOrigin : TEXCOORD5;
};

VS_OUTPUT main( VS_INPUT v )
{
	VS_OUTPUT o = ( VS_OUTPUT )0;
	o.vProjPos = mul( v.vPos, cModelViewProj );
	o.vTexCoord = v.vTexCoord;
	o.vLocalPos = v.vPos.xyz;
	o.vWorldPos = mul4x3( v.vPos, cModel[0] );
	o.vClipPos = o.vProjPos;
#if X360APPCHOOSER
	float4 payload = floor( v.vColor * 255.0f + 0.5f );
	float slotHigh = floor( payload.g / 8.0f );
	float slot = payload.r + slotHigh * 256.0f;
	float face = payload.g - slotHigh * 8.0f;
	float tileRow = floor( slot / 12.0f );
	float tileCol = slot - tileRow * 12.0f;
	o.vColor = float4( 1.0f, face / 255.0f, payload.b / 255.0f, payload.a / 255.0f );
	o.vLightTileOrigin = float2( tileCol * 324.0f, tileRow * 9.0f );
#endif
	return o;
}
