#define HDRTYPE HDR_TYPE_NONE
#include "common_ps_fxc.h"
#include "mc_gpu_block_tint.fxh"

// Heightfield shadow chunk shader ("height" shadow mode).
//
// Instead of sampling a per-frame sun-space shadow map, this variant ray
// marches a cached TOP-DOWN depth map of the world (one R32F texel per
// world column patch) toward the sun. The height map is sun- and
// camera-independent, so Lua only re-renders it when chunk meshes change or
// the window recenters — the every-frame shadow depth pass disappears
// entirely and day-cycle sun motion costs nothing.
//
// Occlusion test per march step: reconstruct the surface height under the
// sample point and compare against the ray height. The soft term
// saturate(dh / (softness * t)) is the classic heightfield penumbra: shadows
// stay crisp near the caster contact and widen with blocker distance.

sampler BaseTextureSampler : register(s0);
sampler ChunkLightSampler  : register(s1);
#include "mc_gpu_chunk_lighttex_packed.fxh"
sampler GlobalLightmapSampler : register(s2);
sampler HeightFieldSampler : register(s3);

// Register layout must match what GMod's screenspace_general family actually
// uploads (verified by disassembling csm_gshader_ps30.vcs):
//   $c0_*..$c3_*     -> c0..c3
//   $viewprojmat     -> c11..c14
//   $invviewprojmat  -> c15..c18
// This shader needs NO shadow matrix: the material must never define
// $viewprojmat or $invviewprojmat, which leaves c4+ (including c11..c18)
// free for compiler-placed inline literal constants.
float4 mcHfParams : register(c0);  // x: strength, y: penumbra softness (tan), z: window top world z, w: window depth range (zfar)
float4 mcHfSunDir : register(c1);  // xyz: normalized direction toward the sun/moon, w: max march distance (world units)
float4 mcHfWindow : register(c2);  // x: window origin world x, y: origin world y, z: up-axis uv scale (signed), w: right-axis uv scale (signed)
float4 mcHfFancy  : register(c3);  // x: shadow cool tint, y: window edge fade, z: back-face shade, w: warmth

static const float MC_GLOBAL_LIGHTMAP_SIZE = 16.0f;

// Heightfield march constants. Steps are exponential: with growth g and N
// steps the first tap lands at maxDist / g^(N-1) (~1 block at the 2400u
// default), the last exactly at maxDist. All literals — the reach scales
// through $c1_w without recompiling.
static const int MC_HF_STEPS = 16;
static const float MC_HF_GROWTH = 1.32f;
// Push the ray start out of the receiving block's own voxel column: without
// this, wall faces would immediately self-occlude against their own column
// top. Also acts as the slope bias for floor receivers.
static const float MC_HF_NORMAL_OFFSET = 12.0f;
// Forgive bilinear height ramps at block edges and depth quantization.
static const float MC_HF_HEIGHT_BIAS = 6.0f;

// Grade colors shared with the fancy pass: cool shadows, warm sun, warm torch.
static const float3 MC_SHADOW_TINT = float3( 0.72f, 0.85f, 1.18f );
static const float3 MC_SUN_WARM = float3( 1.06f, 1.01f, 0.94f );
static const float3 MC_TORCH_WARM = float3( 1.10f, 0.97f, 0.82f );
// Moonlight blue for the night tint; weight arrives in the light texture's
// r channel (baked in Lua as night amount x sky dominance).
static const float3 MC_NIGHT_TINT = float3( 0.62f, 0.74f, 1.12f );

// _centroid: under MSAA, an edge pixel whose center lies outside the triangle
// otherwise EXTRAPOLATES every interpolant — UV lands past the atlas gutter
// (alpha-test holes) and local/world pos past the face (wrong light cell /
// wrong shadow verdict) — the block-edge seam artifact.
struct PS_INPUT
{
	float2 vTexCoord : TEXCOORD0_centroid;
	float3 vLocalPos : TEXCOORD1_centroid;
	float3 vWorldPos : TEXCOORD2_centroid;
	float4 vColor    : TEXCOORD3_centroid;
	float4 vClipPos  : TEXCOORD4_centroid;
	float2 vLightTileOrigin : TEXCOORD5_centroid;
};

float3 faceNormalForIndex( float faceIndex )
{
	// Chunks are axis-aligned (translation-only model matrix), so the local
	// face normal is also the world normal.
	float3 normal = float3( 0.0f, 0.0f, 1.0f );
	if ( faceIndex < 1.5f )
	{
		normal = float3( 0.0f, 0.0f, 1.0f );
	}
	else if ( faceIndex < 2.5f )
	{
		normal = float3( 0.0f, 0.0f, -1.0f );
	}
	else if ( faceIndex < 3.5f )
	{
		normal = float3( 1.0f, 0.0f, 0.0f );
	}
	else if ( faceIndex < 4.5f )
	{
		normal = float3( -1.0f, 0.0f, 0.0f );
	}
	else if ( faceIndex < 5.5f )
	{
		normal = float3( 0.0f, 1.0f, 0.0f );
	}
	else
	{
		normal = float3( 0.0f, -1.0f, 0.0f );
	}
	return normal;
}

float3 faceScaleForIndex( float faceIndex )
{
	float3 scale = float3( 0.8f, 0.8f, 0.8f );
	if ( faceIndex < 1.5f )
	{
		scale = float3( 1.0f, 1.0f, 1.0f );
	}
	else if ( faceIndex < 2.5f )
	{
		scale = float3( 0.5f, 0.5f, 0.5f );
	}
	else if ( faceIndex < 3.5f )
	{
		scale = float3( 0.6f, 0.6f, 0.6f );
	}
	else if ( faceIndex < 4.5f )
	{
		scale = float3( 0.6f, 0.6f, 0.6f );
	}
	else if ( faceIndex < 5.5f )
	{
		scale = float3( 0.8f, 0.8f, 0.8f );
	}
	return scale;
}

float2 globalLightmapUV( float blockLight, float skyLight )
{
	return float2(
		( blockLight + 0.5f ) / MC_GLOBAL_LIGHTMAP_SIZE,
		( skyLight + 0.5f ) / MC_GLOBAL_LIGHTMAP_SIZE
	);
}

float3 sampleGlobalLightmapLevel( float blockLevel, float skyLevel )
{
	return tex2D( GlobalLightmapSampler, globalLightmapUV( blockLevel, skyLevel ) ).rgb;
}

float3 composeGlobalLightmap( float3 lightChannels )
{
	float blockLight = saturate( lightChannels.g );
	float skyLight = saturate( lightChannels.b );
	float2 level = saturate( float2( blockLight, skyLight ) ) * ( MC_GLOBAL_LIGHTMAP_SIZE - 1.0f );
	float2 level0 = floor( level );
	float2 level1 = min( level0 + 1.0f, MC_GLOBAL_LIGHTMAP_SIZE - 1.0f );
	float2 blend = level - level0;
	float3 c00 = sampleGlobalLightmapLevel( level0.x, level0.y );
	float3 c10 = sampleGlobalLightmapLevel( level1.x, level0.y );
	float3 c01 = sampleGlobalLightmapLevel( level0.x, level1.y );
	float3 c11 = sampleGlobalLightmapLevel( level1.x, level1.y );
	float3 c0 = lerp( c00, c10, blend.x );
	float3 c1 = lerp( c01, c11, blend.x );
	float3 color = saturate( lerp( c0, c1, blend.y ) );
	if ( color.r + color.g + color.b <= 0.001f )
	{
		float fallback = max( blockLight, skyLight );
		color = float3( fallback, fallback, fallback );
	}
	return color;
}

// Interleaved gradient noise fed with *screen* pixels (VPOS): jitters the
// march step phase so the exponential tap spacing dithers into fine grain
// instead of banded shadow rings.
float interleavedGradientNoise( float2 pixelPos )
{
	float3 magic = float3( 0.06711056f, 0.00583715f, 52.9829189f );
	return frac( magic.z * frac( dot( pixelPos, magic.xy ) ) );
}

// World position -> heightfield UV. Lua packs the signed per-axis scales so
// the shader never needs the ortho matrix (or its register block):
//   uv.x follows world y through the ortho right axis,
//   uv.y follows world x through the ortho up axis.
float2 hfWindowUV( float3 worldPos )
{
	return float2(
		( worldPos.y - mcHfWindow.y ) * mcHfWindow.w + 0.5f,
		( worldPos.x - mcHfWindow.x ) * mcHfWindow.z + 0.5f
	);
}

// Surface height stored under a heightfield texel, in world z.
float hfSurfaceZ( float2 uv )
{
	return mcHfParams.z - tex2D( HeightFieldSampler, uv ).r * mcHfParams.w;
}

float hfShadowVisibility( float3 worldPos, float3 normal, float2 screenPos )
{
	float strength = saturate( mcHfParams.x );
	if ( strength <= 0.0f )
	{
		return 1.0f;
	}

	float3 toSun = mcHfSunDir.xyz;
	float3 rayOrigin = worldPos + normal * MC_HF_NORMAL_OFFSET;

	// Fade shadows out near the heightfield window border instead of a hard
	// cutoff; beyond the window there is no data and the world stays lit.
	float2 uv0 = hfWindowUV( rayOrigin );
	float2 border = min( uv0, 1.0f - uv0 );
	float inside = saturate( min( border.x, border.y ) / max( mcHfFancy.y, 0.001f ) );
	if ( inside <= 0.0f )
	{
		return 1.0f;
	}

	float maxDist = max( mcHfSunDir.w, 1.0f );
	float jitter = interleavedGradientNoise( screenPos );

	// Exponential march: frac runs growth^-(N-1) .. 1, phase-jittered per
	// pixel. kt = softness * t is iterated alongside for the penumbra.
	float frac0 = pow( MC_HF_GROWTH, -( float )( MC_HF_STEPS - 1 ) ) * lerp( 1.0f, MC_HF_GROWTH, jitter );
	float t = maxDist * frac0;
	float softness = max( mcHfParams.y, 0.005f );
	float occlusion = 0.0f;

	for ( int i = 0; i < MC_HF_STEPS; ++i )
	{
		float3 samplePos = rayOrigin + toSun * t;
		float surfaceZ = hfSurfaceZ( hfWindowUV( samplePos ) );
		float dh = surfaceZ - samplePos.z - MC_HF_HEIGHT_BIAS;
		occlusion = max( occlusion, saturate( dh / ( softness * t ) ) );
		t *= MC_HF_GROWTH;
	}

	float visibility = 1.0f - occlusion * inside;
	return lerp( 1.0f, visibility, strength );
}

float3 hfSunMultiplier( float3 worldPos, float faceIndex, float blockUnit, float2 screenPos )
{
	if ( mcHfParams.x <= 0.0f )
	{
		return float3( 1.0f, 1.0f, 1.0f );
	}

	// Faces pointing away from the sun cannot receive direct sunlight: shade
	// them like cast shadow (min, not multiply — a back face inside a cast
	// shadow is the same darkness, not doubly dark).
	float3 normal = faceNormalForIndex( faceIndex );
	float castVis = hfShadowVisibility( worldPos, normal, screenPos );

	float facing = smoothstep( 0.0f, 0.35f, dot( normal, mcHfSunDir.xyz ) );
	float directionalVis = lerp( 1.0f, facing, saturate( mcHfFancy.z ) * saturate( mcHfParams.x ) );

	// Block light overrides sun shadow: torch-lit surfaces keep their own
	// brightness instead of being darkened by the heightfield shadow.
	float sunVis = lerp( min( castVis, directionalVis ), 1.0f, blockUnit );

	// Cool shadows, warm sun, warm torch pools.
	float shadowAmount = ( 1.0f - sunVis ) * saturate( mcHfFancy.x );
	float warmth = saturate( mcHfFancy.w );
	float3 shadowMul = sunVis * lerp( float3( 1.0f, 1.0f, 1.0f ), MC_SHADOW_TINT, shadowAmount );
	shadowMul *= lerp( float3( 1.0f, 1.0f, 1.0f ), MC_SUN_WARM, warmth * sunVis );
	shadowMul *= lerp( float3( 1.0f, 1.0f, 1.0f ), MC_TORCH_WARM, warmth * blockUnit );
	return shadowMul;
}

HALF4 main( PS_INPUT i, float faceSign : VFACE, float2 vScreenPos : VPOS ) : COLOR
{
	clip( faceSign );
	// tex2Dlod (explicit LOD 0): anisotropic minification must never widen the
	// atlas footprint past the 4px tile gutter into alpha=0 cells (seam holes).
	float4 albedo = tex2Dlod( BaseTextureSampler, float4( i.vTexCoord, 0.0f, 0.0f ) );
	clip( albedo.a - 0.5f );
	albedo.rgb *= mcBlockTint( i.vColor.b );

	float faceIndex = floor( i.vColor.g * 255.0f + 0.5f );
	float3 lightChannels = mcSampleSmoothFaceLight9( i.vLocalPos, faceIndex, i.vLightTileOrigin );
	float blockUnit = saturate( lightChannels.g );
	float3 lightColor = composeGlobalLightmap( lightChannels );
	float3 faceScale = faceScaleForIndex( faceIndex );
	float aoMul = saturate( i.vColor.r );
	float3 sunMul = hfSunMultiplier( i.vWorldPos, faceIndex, blockUnit, vScreenPos );
	float3 lit = saturate( albedo.rgb * lightColor * faceScale * aoMul * sunMul );

	return HALF4( saturate( lit ), 1.0f );
}
